# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is documentation, not a secret, and is the only place
# that records which models Revision 2 uses.
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# learning database — the product, but local and personal
/data
# database snapshots. Personal, and often larger than the database itself.
# They are meant to leave this machine, not to enter the repository.
/backups
# regenerated by scripts/dump-reference.ts; the built HTML is committed
/docs/reference-data.json
# session handoffs (SPEC.md §7) — local artefacts
/handoffs
# licensed source books, traceable to the purchaser. never commit.
/books
